# Server Configuration
PORT=8000
LOG_LEVEL=INFO
ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Global Default Model (format: "provider:model")
DEFAULT_LLM_MODEL=openai:gpt-4o

# LLM API Keys (only secrets go in .env)
OPENAI_API_KEY=your-openai-api-key-here
# CLAUDE_API_KEY=your-claude-api-key-here
# GROK_API_KEY=your-grok-api-key-here

# NOTE: Model defaults and configurations are now in src/services/config.py

# Neo4j Configuration (not currently in use)
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=samvidneo4j

# Database Configuration (optional - for future use)
# DATABASE_URL=postgresql://username:password@localhost:5432/samvid

# Security (optional - for future use)
# API_KEY=your-api-key-here
# JWT_SECRET=your-jwt-secret-here

# Langfuse
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_SECRET_KEY=langfuse-secret-key
LANGFUSE_PUBLIC_KEY=langfuse-private-key
LANGFUSE_OBSERVE_DECORATOR_IO_CAPTURE_ENABLED=True


