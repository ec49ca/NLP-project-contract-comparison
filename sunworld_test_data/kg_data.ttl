@prefix sw: <http://sunworld.com/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix swc: <http://sunworld.com/contract#> .
@prefix swp: <http://sunworld.com/project#> .
@prefix swf: <http://sunworld.com/facility#> .
@prefix swl: <http://sunworld.com/location#> .

# Company Information
sw:SunWorld a org:Organization ;
    foaf:name "SunWorld International" ;
    dct:created "1983"^^xsd:gYear ;
    org:hasRegisteredSite swl:BakersfieldHQ ;
    org:hasPrimarySite swl:BakersfieldHQ ;
    org:hasUnit sw:ExecutiveTeam, sw:RDDepartment, sw:SalesDepartment, sw:LegalDepartment, sw:OperationsDepartment ;
    dct:description "Global leader in premium fruit varieties development and licensing, specializing in seedless citrus and proprietary table grape varieties." ;
    sw:revenue "$550M" ;
    sw:employeeCount "1800"^^xsd:integer .

# Locations
swl:BakersfieldHQ a org:Site ;
    org:siteAddress "Bakersfield, California, USA" ;
    org:siteOf sw:SunWorld ;
    sw:hasResearchFacility swf:BakersfieldLab .

swl:FresnoOffice a org:Site ;
    org:siteAddress "Fresno, California, USA" ;
    org:siteOf sw:SunWorld ;
    sw:hasResearchFacility swf:FresnoFieldStation .

swl:SantiagoOffice a org:Site ;
    org:siteAddress "Santiago, Chile" ;
    org:siteOf sw:SunWorld ;
    sw:hasResearchFacility swf:ChileResearchFarm .

swl:ValenciaOffice a org:Site ;
    org:siteAddress "Valencia, Spain" ;
    org:siteOf sw:SunWorld ;
    sw:hasResearchFacility swf:SpainInnovationCenter .

# Organizational Units
sw:ExecutiveTeam a org:OrganizationalUnit ;
    foaf:name "Executive Team" ;
    org:member sw:DavidMarguleas, sw:MariaRodriguez, sw:RobertKim .

sw:RDDepartment a org:OrganizationalUnit ;
    foaf:name "Research & Development" ;
    org:member sw:MariaRodriguez, sw:JohnPeterson, sw:SarahChen, sw:EmilyWatson, sw:DrChenLi .

sw:SalesDepartment a org:OrganizationalUnit ;
    foaf:name "Sales & Licensing" ;
    org:member sw:AnnaLopez, sw:MichaelBrown .

sw:LegalDepartment a org:OrganizationalUnit ;
    foaf:name "Legal Affairs" ;
    org:member sw:RobertKim, sw:LauraDavis .

sw:OperationsDepartment a org:OrganizationalUnit ;
    foaf:name "Operations" ;
    org:member sw:CarlosGomez, sw:SophiaMiller .

# People
sw:DavidMarguleas a foaf:Person ;
    foaf:name "David Marguleas" ;
    org:role "CEO" ;
    org:memberOf sw:ExecutiveTeam ;
    sw:managesContract swc:C-2020-001, swc:C-2021-005 .

sw:MariaRodriguez a foaf:Person ;
    foaf:name "Dr. Maria Rodriguez" ;
    org:role "Head of R&D" ;
    org:memberOf sw:RDDepartment ;
    sw:leadsProject swp:RND-2023-001, swp:RND-2024-003 .

sw:RobertKim a foaf:Person ;
    foaf:name "Robert Kim" ;
    org:role "General Counsel" ;
    org:memberOf sw:LegalDepartment ;
    sw:approvesContract swc:C-2020-001, swc:C-2022-010 .

sw:JohnPeterson a foaf:Person ;
    foaf:name "John Peterson" ;
    org:role "Senior Plant Breeder" ;
    org:memberOf sw:RDDepartment ;
    sw:developedVariety sw:SWC-1001, sw:SWC-1004 ;
    sw:inventedPatent sw:USPP24509P3 .

sw:SarahChen a foaf:Person ;
    foaf:name "Sarah Chen" ;
    org:role "Geneticist" ;
    org:memberOf sw:RDDepartment ;
    sw:developedVariety sw:SWC-1002, sw:SWC-1005 ;
    sw:inventedPatent sw:USPP28976P3 .

sw:EmilyWatson a foaf:Person ;
    foaf:name "Emily Watson" ;
    org:role "Horticulturist" ;
    org:memberOf sw:RDDepartment ;
    sw:developedVariety sw:SWC-1003, sw:SWC-1006 ;
    sw:inventedPatent sw:USPP31245P3 .

sw:DrChenLi a foaf:Person ;
    foaf:name "Dr. Chen Li" ;
    org:role "Biotechnologist" ;
    org:memberOf sw:RDDepartment ;
    sw:developedVariety sw:SWC-1007, sw:SWC-1008 ;
    sw:leadsProject swp:RND-2024-005 .

sw:AnnaLopez a foaf:Person ;
    foaf:name "Anna Lopez" ;
    org:role "VP Sales" ;
    org:memberOf sw:SalesDepartment ;
    sw:managesLicensee sw:LIC-1001, sw:LIC-1003 .

sw:MichaelBrown a foaf:Person ;
    foaf:name "Michael Brown" ;
    org:role "Regional Sales Manager" ;
    org:memberOf sw:SalesDepartment ;
    sw:managesLicensee sw:LIC-1002, sw:LIC-1004 .

sw:LauraDavis a foaf:Person ;
    foaf:name "Laura Davis" ;
    org:role "Legal Counsel" ;
    org:memberOf sw:LegalDepartment ;
    sw:draftsContract swc:C-2021-005, swc:C-2023-015 .

sw:CarlosGomez a foaf:Person ;
    foaf:name "Carlos Gomez" ;
    org:role "Director of Operations" ;
    org:memberOf sw:OperationsDepartment ;
    sw:overseesGrower sw:GRW-1001, sw:GRW-1003 .

sw:SophiaMiller a foaf:Person ;
    foaf:name "Sophia Miller" ;
    org:role "Supply Chain Manager" ;
    org:memberOf sw:OperationsDepartment ;
    sw:managesDistributor sw:DIST-1001, sw:DIST-1002 .

# Research Facilities
swf:BakersfieldLab a sw:ResearchFacility ;
    rdfs:label "Bakersfield R&D Lab" ;
    sw:location swl:BakersfieldHQ ;
    sw:focus "Grape Breeding", "Genomics" ;
    sw:hasResearcher sw:JohnPeterson, sw:SarahChen .

swf:FresnoFieldStation a sw:ResearchFacility ;
    rdfs:label "Fresno Field Station" ;
    sw:location swl:FresnoOffice ;
    sw:focus "Stone Fruit Trials", "Pest Management" ;
    sw:hasResearcher sw:EmilyWatson .

swf:ChileResearchFarm a sw:ResearchFacility ;
    rdfs:label "Chile Research Farm" ;
    sw:location swl:SantiagoOffice ;
    sw:focus "Southern Hemisphere Trials", "Early Season Varieties" ;
    sw:hasResearcher sw:DrChenLi .

swf:SpainInnovationCenter a sw:ResearchFacility ;
    rdfs:label "Spain Innovation Center" ;
    sw:location swl:ValenciaOffice ;
    sw:focus "Citrus Development", "Drought Resistance" ;
    sw:hasResearcher sw:MariaRodriguez .

# Varieties
sw:SWC-1001 a sw:Variety ;
    rdfs:label "Cotton Candy™ Grapes" ;
    sw:type "Table Grape" ;
    sw:developmentYear "2011"^^xsd:gYear ;
    sw:patent sw:USPP24509P3 ;
    sw:licensingStatus "Active" ;
    sw:yieldPerAcre "8-10 tons" ;
    sw:characteristic "seedless", "sweet flavor", "cotton candy aroma" ;
    sw:availableInMarket "North America", "Europe", "Asia" ;
    sw:developedBy sw:JohnPeterson ;
    sw:testedAt swf:BakersfieldLab .

sw:SWC-1002 a sw:Variety ;
    rdfs:label "SunnyGlo™ Apricots" ;
    sw:type "Apricot" ;
    sw:developmentYear "2018"^^xsd:gYear ;
    sw:patent sw:USPP28976P3 ;
    sw:licensingStatus "Active" ;
    sw:yieldPerAcre "12-15 tons" ;
    sw:characteristic "sweet-tart balance", "firm texture", "extended shelf life" ;
    sw:availableInMarket "North America", "Europe" ;
    sw:developedBy sw:SarahChen ;
    sw:testedAt swf:FresnoFieldStation .

sw:SWC-1003 a sw:Variety ;
    rdfs:label "Midnight™ Blueberries" ;
    sw:type "Blueberry" ;
    sw:developmentYear "2020"^^xsd:gYear ;
    sw:patent sw:USPP31245P3 ;
    sw:licensingStatus "Active" ;
    sw:yieldPerAcre "10-12 tons" ;
    sw:characteristic "large size", "sweet flavor", "high antioxidant content" ;
    sw:availableInMarket "North America", "Asia", "Middle East" ;
    sw:developedBy sw:EmilyWatson ;
    sw:testedAt swf:FresnoFieldStation .

sw:SWC-1004 a sw:Variety ;
    rdfs:label "Crimson Crisp™ Grapes" ;
    sw:type "Table Grape" ;
    sw:developmentYear "2015"^^xsd:gYear ;
    sw:patent sw:USPP27890P3 ;
    sw:licensingStatus "Active" ;
    sw:yieldPerAcre "9-11 tons" ;
    sw:characteristic "crisp texture", "tart flavor", "deep red color" ;
    sw:availableInMarket "North America", "South America" ;
    sw:developedBy sw:JohnPeterson ;
    sw:testedAt swf:BakersfieldLab .

sw:SWC-1005 a sw:Variety ;
    rdfs:label "Golden Delight™ Peaches" ;
    sw:type "Peach" ;
    sw:developmentYear "2019"^^xsd:gYear ;
    sw:patent sw:USPP30123P3 ;
    sw:licensingStatus "Active" ;
    sw:yieldPerAcre "14-16 tons" ;
    sw:characteristic "juicy", "aromatic", "golden flesh" ;
    sw:availableInMarket "Europe", "Asia" ;
    sw:developedBy sw:SarahChen ;
    sw:testedAt swf:FresnoFieldStation .

sw:SWC-1006 a sw:Variety ;
    rdfs:label "Evergreen™ Kiwi" ;
    sw:type "Kiwi" ;
    sw:developmentYear "2021"^^xsd:gYear ;
    sw:patent sw:USPP32456P3 ;
    sw:licensingStatus "Trial" ;
    sw:yieldPerAcre "11-13 tons" ;
    sw:characteristic "smooth skin", "tropical flavor", "long storage" ;
    sw:availableInMarket "Trial Markets" ;
    sw:developedBy sw:EmilyWatson ;
    sw:testedAt swf:ChileResearchFarm .

sw:SWC-1007 a sw:Variety ;
    rdfs:label "Desert Bloom™ Citrus" ;
    sw:type "Citrus" ;
    sw:developmentYear "2022"^^xsd:gYear ;
    sw:patent sw:USPP33500P3 ;
    sw:licensingStatus "Development" ;
    sw:yieldPerAcre "10-12 tons" ;
    sw:characteristic "drought resistant", "sweet", "thin peel" ;
    sw:availableInMarket "N/A" ;
    sw:developedBy sw:DrChenLi ;
    sw:testedAt swf:SpainInnovationCenter .

sw:SWC-1008 a sw:Variety ;
    rdfs:label "Arctic Berry™ Strawberries" ;
    sw:type "Strawberry" ;
    sw:developmentYear "2023"^^xsd:gYear ;
    sw:patent sw:USPP34000P3 ;
    sw:licensingStatus "Early Trial" ;
    sw:yieldPerAcre "7-9 tons" ;
    sw:characteristic "cold tolerant", "intense flavor", "vibrant red" ;
    sw:availableInMarket "N/A" ;
    sw:developedBy sw:DrChenLi ;
    sw:testedAt swf:ChileResearchFarm .

# Licensees
sw:LIC-1001 a sw:Licensee ;
    foaf:name "Global Fruit Growers Inc." ;
    sw:country "United States" ;
    sw:licenseType "Exclusive" ;
    sw:territory "North America" ;
    sw:hasLicenseFor sw:SWC-1001, sw:SWC-1002, sw:SWC-1004 ;
    sw:hasContract swc:C-2020-001, swc:C-2023-015 .

sw:LIC-1002 a sw:Licensee ;
    foaf:name "EuroHarvest AG" ;
    sw:country "Netherlands" ;
    sw:licenseType "Non-exclusive" ;
    sw:territory "European Union", "UK" ;
    sw:hasLicenseFor sw:SWC-1001, sw:SWC-1003, sw:SWC-1005 ;
    sw:hasContract swc:C-2019-003, swc:C-2022-010 .

sw:LIC-1003 a sw:Licensee ;
    foaf:name "Asia Pacific Produce Ltd." ;
    sw:country "Australia" ;
    sw:licenseType "Exclusive" ;
    sw:territory "Asia Pacific" ;
    sw:hasLicenseFor sw:SWC-1001, sw:SWC-1003, sw:SWC-1006 ;
    sw:hasContract swc:C-2021-005, swc:C-2024-020 .

sw:LIC-1004 a sw:Licensee ;
    foaf:name "South American Fresh" ;
    sw:country "Chile" ;
    sw:licenseType "Non-exclusive" ;
    sw:territory "South America" ;
    sw:hasLicenseFor sw:SWC-1004, sw:SWC-1006, sw:SWC-1008 ;
    sw:hasContract swc:C-2022-012, swc:C-2023-018 .

