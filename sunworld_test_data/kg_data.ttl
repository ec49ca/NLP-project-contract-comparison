# Research Projects
swp:RND-2023-001 a sw:ResearchProject ;
    rdfs:label "Drought-Resistant Citrus" ;
    dct:startDate "2023-03-15"^^xsd:date ;
    sw:status "Active" ;
    sw:leadResearcher sw:MariaRodriguez ;
    sw:collaborator "University of California, Davis", "Spanish National Research Council" ;
    dct:description "Development of citrus varieties with enhanced drought tolerance for water-scarce regions." ;
    sw:hasPhase swp:RND-2023-001-Phase1, swp:RND-2023-001-Phase2 ;
    sw:developedVariety sw:SWC-1007 ;
    sw:conductedAt swf:SpainInnovationCenter .

swp:RND-2022-045 a sw:ResearchProject ;
    rdfs:label "Extended Shelf-Life Berries" ;
    dct:startDate "2022-09-01"^^xsd:date ;
    dct:endDate "2023-08-30"^^xsd:date ;
    sw:status "Completed" ;
    sw:outcome "Successfully developed new blueberry variety with 40% longer shelf life" ;
    sw:leadResearcher sw:EmilyWatson ;
    sw:developedVariety sw:SWC-1003 ;
    sw:conductedAt swf:FresnoFieldStation .

swp:RND-2024-003 a sw:ResearchProject ;
    rdfs:label "Next-Gen Seedless Grapes" ;
    dct:startDate "2024-01-10"^^xsd:date ;
    sw:status "Active" ;
    sw:leadResearcher sw:MariaRodriguez ;
    sw:collaborator "CSIRO Australia" ;
    dct:description "Breeding program for new seedless grape varieties with improved disease resistance and flavor profiles." ;
    sw:hasPhase swp:RND-2024-003-Phase1 ;
    sw:conductedAt swf:BakersfieldLab .

swp:RND-2024-005 a sw:ResearchProject ;
    rdfs:label "Cold-Tolerant Berry Development" ;
    dct:startDate "2024-04-01"^^xsd:date ;
    sw:status "Active" ;
    sw:leadResearcher sw:DrChenLi ;
    sw:collaborator "University of Florida" ;
    dct:description "Developing berry varieties that can withstand colder climates, extending growing seasons." ;
    sw:developedVariety sw:SWC-1008 ;
    sw:conductedAt swf:ChileResearchFarm .

# Research Project Phases
swp:RND-2023-001-Phase1 a swp:ProjectPhase ;
    rdfs:label "Drought-Resistant Citrus - Phase 1: Gene Identification" ;
    dct:startDate "2023-03-15"^^xsd:date ;
    dct:endDate "2024-03-14"^^xsd:date ;
    sw:status "Completed" ;
    sw:outcome "Identified 5 key drought-tolerance genes" ;
    sw:partOf swp:RND-2023-001 .

swp:RND-2023-001-Phase2 a swp:ProjectPhase ;
    rdfs:label "Drought-Resistant Citrus - Phase 2: Breeding & Trials" ;
    dct:startDate "2024-03-15"^^xsd:date ;
    sw:status "Active" ;
    sw:outcome "Ongoing field trials of new citrus crosses" ;
    sw:partOf swp:RND-2023-001 .

swp:RND-2024-003-Phase1 a swp:ProjectPhase ;
    rdfs:label "Next-Gen Seedless Grapes - Phase 1: Germplasm Screening" ;
    dct:startDate "2024-01-10"^^xsd:date ;
    sw:status "Active" ;
    sw:outcome "Screening thousands of germplasm lines for desired traits" ;
    sw:partOf swp:RND-2024-003 .

