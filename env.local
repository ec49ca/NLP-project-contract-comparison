# Server Configuration
PORT=8001
LOG_LEVEL=INFO
ENV=development

ENCRYPTION_KEY=samvid-production-encryption-key-2025

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Global Default Model (format: "provider:model")
DEFAULT_LLM_MODEL=openai:gpt-4o

# LLM API Keys (only secrets go in .env)
OPENAI_API_KEY=
# CLAUDE_API_KEY=your-claude-api-key-here
# GROK_API_KEY=your-grok-api-key-here

# Neo4j Configuration (required for Knowledge Graph Agent)
# change for prod
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=samvidneo4j

# Database Configuration (optional - for future use)
# DATABASE_URL=postgresql://username:password@localhost:5432/samvid

# Langfuse
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_OBSERVE_DECORATOR_IO_CAPTURE_ENABLED=True