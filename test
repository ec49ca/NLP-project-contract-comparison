#!/bin/bash
# Simple test runner script
# Usage: ./test [category] [options]

set -e  # Exit on any error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    echo -e "${BLUE}🧪 $1${NC}"
}

print_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

print_error() {
    echo -e "${RED}❌ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

# Help function
show_help() {
    echo "📋 Test Runner Commands:"
    echo ""
    echo "  ./test              - Run all tests"
    echo "  ./test config       - Run configuration tests only"
    echo "  ./test server       - Run server endpoint tests only"
    echo "  ./test llm          - Run LLM service tests only"
    echo "  ./test agents       - Run agent functionality tests only"
    echo "  ./test unit         - Run unit tests only"
    echo "  ./test integration  - Run integration tests only"
    echo "  ./test quick        - Run fastest tests only"
    echo "  ./test verbose      - Run all tests with verbose output"
    echo "  ./test watch        - Watch files and re-run tests on changes"
    echo "  ./test help         - Show this help"
    echo ""
    echo "Examples:"
    echo "  ./test config       # Test just configuration"
    echo "  ./test server -v    # Test server endpoints with verbose output"
    echo "  ./test              # Run everything"
}

# Check if pytest is available
if ! command -v pytest &> /dev/null; then
    print_error "pytest not found. Please install with: pip install pytest pytest-asyncio"
    exit 1
fi

# Main logic
case "${1:-all}" in
    "help"|"-h"|"--help")
        show_help
        ;;

    "config")
        print_status "Running configuration tests..."
        pytest -m config ${@:2}
        ;;

    "server")
        print_status "Running server endpoint tests..."
        pytest -m server ${@:2}
        ;;

    "llm")
        print_status "Running LLM service tests..."
        pytest -m llm ${@:2}
        ;;

    "agents")
        print_status "Running agent functionality tests..."
        pytest -m agents ${@:2}
        ;;

    "unit")
        print_status "Running unit tests..."
        pytest -m unit ${@:2}
        ;;

    "integration")
        print_status "Running integration tests..."
        pytest -m integration ${@:2}
        ;;

    "quick")
        print_status "Running quick tests (unit + config)..."
        pytest -m "unit or config" ${@:2}
        ;;

    "verbose")
        print_status "Running all tests with verbose output..."
        pytest -v ${@:2}
        ;;

    "watch")
        print_status "Watching for changes and re-running tests..."
        if command -v pytest-watch &> /dev/null; then
            pytest-watch ${@:2}
        else
            print_warning "pytest-watch not installed. Install with: pip install pytest-watch"
            print_status "Running tests once instead..."
            pytest ${@:2}
        fi
        ;;

    "all"|"")
        print_status "Running all tests..."
        pytest ${@:2}
        ;;

    *)
        print_error "Unknown command: $1"
        echo ""
        show_help
        exit 1
        ;;
esac

# Show test results summary if tests ran successfully
if [ $? -eq 0 ]; then
    print_success "Tests completed successfully!"
else
    print_error "Some tests failed. Check output above for details."
    exit 1
fi