# Supply Chain - Growers
sw:GRW-1001 a sw:Grower ;
    foaf:name "Central Valley Orchards" ;
    sw:location "California, USA" ;
    sw:grows sw:SWC-1001, sw:SWC-1002, sw:SWC-1004 ;
    sw:certification "GlobalGAP", "Organic" ;
    sw:suppliesTo sw:DIST-1001 .

sw:GRW-1002 a sw:Grower ;
    foaf:name "Andalusian Fruit Co." ;
    sw:location "Andalusia, Spain" ;
    sw:grows sw:SWC-1001, sw:SWC-1003, sw:SWC-1005 ;
    sw:certification "GRASP", "GlobalGAP" ;
    sw:suppliesTo sw:DIST-1002 .

sw:GRW-1003 a sw:Grower ;
    foaf:name "Southern Hemisphere Farms" ;
    sw:location "Valparaíso, Chile" ;
    sw:grows sw:SWC-1004, sw:SWC-1006, sw:SWC-1008 ;
    sw:certification "ChileGAP" ;
    sw:suppliesTo sw:DIST-1001, sw:DIST-1003 .

sw:GRW-1004 a sw:Grower ;
    foaf:name "Mediterranean Produce" ;
    sw:location "Sicily, Italy" ;
    sw:grows sw:SWC-1005, sw:SWC-1007 ;
    sw:certification "GlobalGAP" ;
    sw:suppliesTo sw:DIST-1002 .

