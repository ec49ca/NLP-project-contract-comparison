# Server Configuration
PORT=8000
LOG_LEVEL=INFO
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Global Default Model (format: "provider:model")
DEFAULT_LLM_MODEL=openai:gpt-4o
# Examples:
# DEFAULT_LLM_MODEL=openai:gpt-4o
# DEFAULT_LLM_MODEL=openai:gpt-4o-mini
# DEFAULT_LLM_MODEL=claude:claude-3-5-sonnet
# DEFAULT_LLM_MODEL=claude:claude-3-opus

# LLM API Keys (only secrets go in .env)
OPENAI_API_KEY=your-openai-api-key-here
CLAUDE_API_KEY=your-claude-api-key-here
# GROK_API_KEY=your-grok-api-key-here

# NOTE: Model defaults and configurations are now in src/services/config.py

# Neo4j Configuration (required for Knowledge Graph Agent)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=samvidneo4j

# Database Configuration (optional - for future use)
# DATABASE_URL=postgresql://username:password@localhost:5432/samvid

# API Configuration (optional - for future use)
# SAMVID_API_URL=http://localhost:3000/api

# Security (optional - for future use)
# API_KEY=your-api-key-here
# JWT_SECRET=your-jwt-secret-here